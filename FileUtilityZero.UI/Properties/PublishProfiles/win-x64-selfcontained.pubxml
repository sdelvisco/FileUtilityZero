<Project>
  <!--
    Self-contained, single-file win-x64 publish profile, used to produce the
    payload the Inno Setup script in installer/ packages into the installer.
    Bundles the .NET 10 runtime into the output, so the target machine needs
    no separate .NET runtime install.

    Run with:
      dotnet publish FileUtilityZero.UI\FileUtilityZero.UI.csproj -c Release -p:PublishProfile=win-x64-selfcontained

    See BUILDING.md for the full release build walkthrough.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundles any native (non-managed) dependency libraries into the single
         exe instead of leaving them as loose files alongside it. None of
         this app's current dependencies ship native binaries, so this has
         no visible effect today, but it keeps the "one file" guarantee
         intact if that ever changes. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
